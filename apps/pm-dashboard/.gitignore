# Adapted from templates/gitignore.example for this Next.js + Supabase app.

# --- Secrets / env ---
.env
.env.local
.env.*.local

# --- Dependencies ---
node_modules/

# --- Build output / caches ---
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts
test-results/
playwright-report/

# --- Supabase CLI local state ---
supabase/.temp/
supabase/.branches/

# --- Editor / OS ---
.DS_Store
.vscode/
.idea/

# --- Logs ---
*.log
npm-debug.log*

# --- Source maps (security.md SEC-024: never shipped publicly) ---
*.map

# --- Python bytecode (standards scripts) ---
__pycache__/
*.pyc
