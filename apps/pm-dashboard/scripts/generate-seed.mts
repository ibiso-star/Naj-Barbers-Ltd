// Generates supabase/seed.sql from src/lib/data/seed.ts so the browser demo
// and a real Supabase project share identical rows and IDs.
// Usage: node scripts/generate-seed.mts   (Node 22.18+ strips types natively)
import { writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import {
  SEED_INVITATIONS, SEED_MEMBERS, SEED_PROJECTS, SEED_SUBTASKS, SEED_TASKS,
  SEED_USERS, SEED_WORKSPACES, materialiseSeed,
} from "../src/lib/data/seed.ts";

const q = (v: string | null) => (v === null ? "null" : `'${v.replaceAll("'", "''")}'`);
const hoursAgo = (h: number) => `now() - interval '${h} hours'`;
const daysFromToday = (d: number | null) => (d === null ? "null" : `current_date + ${d}`);
const rows = (xs: string[]) => xs.join(",\n  ");

// Activity is reproduced from the same materialiser the demo uses, expressed
// as offsets from now() so history lines up with the task timestamps.
const now = new Date();
const seeded = materialiseSeed(now);
const hoursBefore = (iso: string) => Math.round((now.getTime() - Date.parse(iso)) / 3_600_000);

const sql = `-- GENERATED by scripts/generate-seed.mts from src/lib/data/seed.ts — do not edit by hand.
-- Fictional demo data for local development and previews only. Never run
-- this against a production project (OPS-001: no real data in staging, and
-- no demo data in production).
--
-- Triggers are disabled while seeding so historical timestamps, numbers and
-- activity rows are inserted exactly as written instead of being re-stamped.

begin;
set local session_replication_role = replica;

insert into auth.users (instance_id, id, aud, role, email, encrypted_password, email_confirmed_at,
  raw_app_meta_data, raw_user_meta_data, created_at, updated_at,
  confirmation_token, recovery_token, email_change_token_new, email_change)
values
  ${rows(SEED_USERS.map((u) => `('00000000-0000-0000-0000-000000000000', ${q(u.id)}, 'authenticated', 'authenticated', ${q(u.email)}, '', now(), '{"provider":"email","providers":["email"]}', ${q(JSON.stringify({ full_name: u.fullName }))}, ${hoursAgo(u.joinedDaysAgo * 24)}, now(), '', '', '', '')`))}
on conflict (id) do nothing;

insert into public.profiles (id, email, full_name, created_at) values
  ${rows(SEED_USERS.map((u) => `(${q(u.id)}, ${q(u.email)}, ${q(u.fullName)}, ${hoursAgo(u.joinedDaysAgo * 24)})`))};

insert into public.workspaces (id, slug, name, plan, task_counter, created_at) values
  ${rows(SEED_WORKSPACES.map((w) => `(${q(w.id)}, ${q(w.slug)}, ${q(w.name)}, ${q(w.plan)}, ${seeded.taskCounters[w.id] ?? 0}, ${hoursAgo(w.createdDaysAgo * 24)})`))};

insert into public.workspace_members (workspace_id, user_id, role, joined_at) values
  ${rows(SEED_MEMBERS.map((m) => `(${q(m.workspaceId)}, ${q(m.userId)}, ${q(m.role)}, ${hoursAgo(m.joinedDaysAgo * 24)})`))};

insert into public.workspace_invitations (id, workspace_id, email, role, invited_by, created_at, expires_at) values
  ${rows(SEED_INVITATIONS.map((i) => `(${q(i.id)}, ${q(i.workspaceId)}, ${q(i.email)}, ${q(i.role)}, ${q(i.invitedBy)}, ${hoursAgo(i.createdHoursAgo)}, ${hoursAgo(i.createdHoursAgo)} + interval '30 days')`))};

insert into public.projects (id, workspace_id, key, name, description, status, lead_id, budget_cents, color, start_date, target_date, created_at, updated_at) values
  ${rows(SEED_PROJECTS.map((p) => `(${q(p.id)}, ${q(p.workspaceId)}, ${q(p.key)}, ${q(p.name)}, ${q(p.description)}, ${q(p.status)}, ${q(p.leadId)}, ${p.budgetCents}, ${q(p.color)}, ${daysFromToday(p.startOffsetDays)}, ${daysFromToday(p.targetOffsetDays)}, ${hoursAgo(p.createdDaysAgo * 24)}, ${hoursAgo(p.createdDaysAgo * 24)})`))};

insert into public.tasks (id, workspace_id, project_id, number, title, description, status, priority, assignee_id, due_date, position, completed_at, created_by, created_at, updated_at) values
  ${rows(SEED_TASKS.map((t) => `(${q(t.id)}, ${q(t.workspaceId)}, ${q(t.projectId)}, ${t.number}, ${q(t.title)}, ${q(t.description)}, ${q(t.status)}, ${q(t.priority)}, ${q(t.assigneeId)}, ${daysFromToday(t.dueOffsetDays)}, ${t.position}, ${t.completedHoursAgo === null ? "null" : hoursAgo(t.completedHoursAgo)}, ${q(t.assigneeId)}, ${hoursAgo(t.createdHoursAgo)}, ${hoursAgo(t.updatedHoursAgo)})`))};

insert into public.subtasks (id, workspace_id, task_id, title, done, position, created_at) values
  ${rows(SEED_SUBTASKS.map((s) => `(${q(s.id)}, ${q(s.workspaceId)}, ${q(s.taskId)}, ${q(s.title)}, ${s.done}, ${s.position}, ${hoursAgo(s.createdHoursAgo)})`))};

insert into public.task_activity (workspace_id, task_id, actor_id, kind, from_value, to_value, created_at) values
  ${rows(seeded.activity.map((a) => `(${q(a.workspaceId)}, ${q(a.taskId)}, ${q(a.actorId)}, ${q(a.kind)}, ${q(a.fromValue)}, ${q(a.toValue)}, ${hoursAgo(hoursBefore(a.createdAt))})`))};

commit;
`;

const out = fileURLToPath(new URL("../supabase/seed.sql", import.meta.url));
writeFileSync(out, sql);
console.log(`wrote ${out}: ${SEED_TASKS.length} tasks, ${SEED_PROJECTS.length} projects`);
