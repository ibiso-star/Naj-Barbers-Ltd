# Copy to .env.local. With both values empty the app runs in demo mode:
# fictional sample data stored in this browser only (PRD.md §4 F9).
# Never commit a filled-in .env file (security.md SEC-018/SEC-020).

# --- Supabase (Project Settings -> API) ---
# The anon/publishable key is designed to be public; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role key is intentionally NOT used by this app. Do not add it.

# --- App ---
# Absolute origin used to build the magic-link redirect URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
