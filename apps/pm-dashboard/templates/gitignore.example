# Copy to .gitignore in a new project. Not exhaustive — add per-tool entries
# as they come up (a new build tool, a new local cache dir, etc).

# --- Secrets / env ---
.env
.env.local
.env.*.local

# --- Dependencies ---
node_modules/
.venv/
__pycache__/
*.pyc

# --- Build output ---
.next/
dist/
build/
*.egg-info/

# --- Infra ---
.terraform/
*.tfstate
*.tfstate.backup

# --- Editor / OS ---
.DS_Store
.vscode/
.idea/

# --- Logs ---
*.log
npm-debug.log*

# --- Source maps (8.1/security.md: never ship publicly, but also don't
# commit the private copies you upload to Sentry) ---
*.map
