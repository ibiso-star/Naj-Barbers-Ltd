# Copy to .env.example in a new project and keep it current (PRD.md 8.3).
# Never commit an actual .env with real values (PRD.md 8.1).
# Placeholders below match the reference stack in PRD.md section 7 —
# delete/replace rows for any vendor this project doesn't use, and say why
# in PRD.md's {{STACK_DEVIATION_REASON}} field if deviating.

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/{{PROJECT_NAME}}
REDIS_URL=redis://localhost:6379

# --- Auth (Clerk) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Payments (Stripe) ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Error tracking (Sentry) ---
SENTRY_DSN=

# --- Product analytics (PostHog) ---
POSTHOG_API_KEY=
POSTHOG_HOST=

# --- AWS ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
SQS_QUEUE_URL=

# --- App ---
NODE_ENV=development
API_BASE_URL=http://localhost:8000
