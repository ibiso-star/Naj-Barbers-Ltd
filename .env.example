# Copy to .env.local and fill in. The app runs with demo/placeholder data
# and no real persistence if these are left unset — see PRD.md §0 and §9.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Dashboard -> Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used to build absolute redirect URLs for Stripe Checkout.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
